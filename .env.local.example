# Copy this file to .env.local, which is ignored by Git.
# Every replace-with value is local-only and must be changed before starting Compose.

# Data and local persistence paths inside the API container.
OPS_KNOWLEDGE_FILE=/app/examples/knowledge.json
OPS_SERVICE_STATUS_FILE=/app/examples/service_statuses.json
OPS_AUDIT_LOG_FILE=/app/var/audit-events.jsonl
OPS_APPROVAL_DATABASE_FILE=/app/var/approvals.sqlite3

# Optional shared local services, reached from a Docker container.
OPS_REDIS_URL=redis://host.docker.internal:6379/0
OPS_PROMETHEUS_URL=http://host.docker.internal:9090
# Keep the public issuer used in locally obtained JWTs separate from Docker's
# internal route used only to fetch Keycloak signing keys.
OPS_KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/ops
OPS_KEYCLOAK_AUDIENCE=ops-api
OPS_KEYCLOAK_JWKS_URL=http://host.docker.internal:8080/realms/ops/protocol/openid-connect/certs

# Separate machine-to-machine credentials. Never reuse these as human API keys.
OPS_PROMETHEUS_SCRAPE_TOKEN=replace-with-prometheus-scrape-token
OPS_ALERT_WEBHOOK_TOKEN=replace-with-alert-webhook-token

# Required only by the isolated alert-relay container.
OPS_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
OPS_TELEGRAM_CHAT_ID=replace-with-numeric-telegram-chat-id
